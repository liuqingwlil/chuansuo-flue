<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">
    <PreferenceCategory app:title="@string/setting_group_developer"
        app:icon="@drawable/ic_menu_dev" app:layout="@layout/secondary_preference_section"
        app:iconSpaceReserved="false">
        <EditTextPreference app:key="setting_map_key" app:layout="@layout/secondary_preference_row"
            app:title="@string/setting_map_key" app:summary="@string/setting_map_key_summary"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat app:key="setting_log_off" app:layout="@layout/secondary_preference_row"
            app:title="@string/setting_log_off" app:summary="@string/setting_log_restart" app:defaultValue="false" app:iconSpaceReserved="false" />
    </PreferenceCategory>
</PreferenceScreen>
