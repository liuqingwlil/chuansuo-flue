<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:orientation="vertical">

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/ui_line" />

    <TextView
        android:id="@+id/poi_address"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/ui_ink"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/poi_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/ui_muted"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/poi_coordinates_gps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/ui_muted"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/poi_coordinates_baidu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/ui_muted"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/poi_save"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/map_secondary_action"
            android:backgroundTint="@null"
            android:minHeight="44dp"
            android:paddingHorizontal="6dp"
            android:text="@string/map_save"
            android:textAllCaps="false"
            android:textColor="@color/ui_ink"
            android:textSize="13sp" />

        <Button
            android:id="@+id/poi_copy"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/map_secondary_action"
            android:backgroundTint="@null"
            android:minHeight="44dp"
            android:paddingHorizontal="6dp"
            android:text="@string/map_copy"
            android:textAllCaps="false"
            android:textColor="@color/ui_ink"
            android:textSize="13sp" />

        <Button
            android:id="@+id/poi_share"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/map_secondary_action"
            android:backgroundTint="@null"
            android:minHeight="44dp"
            android:paddingHorizontal="6dp"
            android:text="@string/map_share"
            android:textAllCaps="false"
            android:textColor="@color/ui_ink"
            android:textSize="13sp" />

        <Button
            android:id="@+id/poi_fly"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/map_secondary_action"
            android:backgroundTint="@null"
            android:minHeight="44dp"
            android:paddingHorizontal="6dp"
            android:text="@string/map_use_point"
            android:textAllCaps="false"
            android:textColor="@color/ui_ink"
            android:textSize="13sp"
            android:visibility="gone" />

    </LinearLayout>
</LinearLayout>
