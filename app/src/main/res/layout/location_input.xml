<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/map_panel"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="10dp"
    android:paddingBottom="18dp">

    <View
        android:layout_width="38dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/map_handle" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"
        android:text="@string/map_input_title"
        android:textColor="@color/ui_ink"
        android:textSize="22sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/map_coordinate_format"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/map_field"
        android:checkedButton="@+id/pos_type_bd"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/pos_type_gps"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:buttonTint="@color/colorPrimary"
            android:text="@string/input_position_gps"
            android:textColor="@color/ui_ink" />

        <RadioButton
            android:id="@id/pos_type_bd"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:buttonTint="@color/colorPrimary"
            android:text="@string/input_position_baidu"
            android:textColor="@color/ui_ink" />
    </RadioGroup>

    <EditText
        android:id="@+id/joystick_longitude"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/map_secondary_action"
        android:hint="@string/label_longitude"
        android:inputType="numberDecimal|numberSigned"
        android:minHeight="48dp"
        android:paddingHorizontal="12dp"
        android:selectAllOnFocus="true"
        android:singleLine="true"
        android:textColor="@color/ui_ink"
        android:textColorHint="@color/ui_muted" />

    <EditText
        android:id="@+id/joystick_latitude"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/map_secondary_action"
        android:hint="@string/label_latitude"
        android:inputType="numberDecimal|numberSigned"
        android:minHeight="48dp"
        android:paddingHorizontal="12dp"
        android:selectAllOnFocus="true"
        android:singleLine="true"
        android:textColor="@color/ui_ink"
        android:textColorHint="@color/ui_muted" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">
        <Button
            android:id="@+id/input_position_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/map_secondary_action"
            android:backgroundTint="@null"
            android:minHeight="48dp"
            android:paddingHorizontal="10dp"
            android:text="@string/input_position_cancel"
            android:textAllCaps="false"
            android:textColor="@color/ui_ink"
            android:textSize="14sp" />
        <Button
            android:id="@+id/input_position_ok"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/map_primary_action"
            android:backgroundTint="@null"
            android:minHeight="48dp"
            android:paddingHorizontal="10dp"
            android:text="@string/map_coordinate_confirm"
            android:textAllCaps="false"
            android:textColor="@color/ui_on_primary"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
