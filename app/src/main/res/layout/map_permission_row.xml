<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="5dp"
    android:background="@drawable/map_row_background"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:paddingHorizontal="8dp"
    android:paddingVertical="8dp">

    <ImageView
        android:id="@+id/map_permission_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="12dp"
        android:contentDescription="@null"
        android:scaleType="centerInside"
        app:tint="@color/ui_ink" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/map_permission_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/ui_ink"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/map_permission_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/ui_muted"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/map_permission_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textColor="@color/ui_muted"
        android:textSize="13sp" />
</LinearLayout>
