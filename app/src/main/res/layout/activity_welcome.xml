<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_canvas"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <Space
            android:layout_width="1dp"
            android:layout_height="16dp"
            android:layout_weight="1" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:maxHeight="238dp"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/welcome" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:accessibilityHeading="true"
            android:gravity="center"
            android:text="@string/app_name"
            android:textColor="@color/ui_ink"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/welcome_description"
            android:textColor="@color/ui_muted"
            android:textSize="17sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:id="@+id/welcome_credit"
            android:textColor="@color/colorPrimary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="1dp"
            android:layout_height="22dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/welcome_agreement"
                style="@style/SecondaryTextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_agreement" />

            <Button
                android:id="@+id/welcome_privacy"
                style="@style/SecondaryTextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_privacy" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/check_agreement"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:buttonTint="@color/colorPrimary"
            android:text="@string/welcome_agreement_ack"
            android:textColor="@color/ui_ink"
            android:textSize="14sp" />

        <Button
            android:id="@+id/startButton"
            style="@style/SecondaryPrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/welcome_btn_txt" />
    </LinearLayout>
</ScrollView>
