<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="SecondaryToolbar" parent="Widget.AppCompat.Toolbar">
        <item name="android:background">@color/ui_canvas</item>
        <item name="android:minHeight">58dp</item>
        <item name="navigationIcon">@drawable/ic_back</item>
        <item name="titleTextColor">@color/ui_ink</item>
        <item name="titleTextAppearance">@style/SecondaryToolbar.Title</item>
        <item name="contentInsetStartWithNavigation">52dp</item>
    </style>

    <style name="SecondaryToolbar.Title" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="SecondaryPrimaryButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/secondary_primary</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/ui_on_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SecondaryTextButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">@drawable/secondary_row_states</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>
